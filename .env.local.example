# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Minimo 16 caratteri; protegge la creazione del primo amministratore
SETUP_SECRET=sostituisci-con-un-segreto-lungo-e-casuale

# App URL (usato per generare PDF via API interna)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=/

# Email (nodemailer) — opzionale
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua@email.com
SMTP_PASS=app-password
SMTP_FROM="Report Pulizie <tua@email.com>"

# Telegram Bot — opzionale
TELEGRAM_BOT_TOKEN=

# Monitoraggio errori opzionale
NEXT_PUBLIC_SENTRY_DSN=
