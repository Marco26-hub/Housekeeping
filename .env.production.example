# Email (opzionale)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Report Pulizie <noreply@example.com>"

# Telegram (opzionale)
TELEGRAM_BOT_TOKEN=

# Monitoraggio errori (opzionale)
NEXT_PUBLIC_SENTRY_DSN=
