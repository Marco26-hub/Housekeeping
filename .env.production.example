# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Protegge /api/setup; usare almeno 32 caratteri casuali
SETUP_SECRET=

# URL HTTPS pubblico, senza slash finale
NEXT_PUBLIC_APP_URL=https://your-housekeeping-domain.example
